// Rollback Pong: two peers in one process, each with its own copy of the game, talking over a
// simulated network that delays, reorders and loses packets. Each peer guesses the other
// player's input and rolls back when the guess was wrong, so both copies end up the same, bit
// for bit, and the checksums they swap every 30 frames prove it.
//
//   kestrel run demos/pong/pong.kes
//   kestrel run demos/pong/pong.kes pong.replay
//
// Controls: W and S move player 1 (the left paddle); with neither held, a bot plays it. Player 2
// is always a bot. Tab shows the other peer's view (peer 2's, which sees your moves 100 ms
// late). R checks the in-memory replay: the confirmed inputs, run again from the seed, must give
// the same checksums.
//
// At the end of a run the replay is saved to `pong.replay` next to the program. Given a file, as
// in the second command (a relative path is next to the program too), Pong plays nothing: it
// reads that replay, runs it again and prints the check's result, as the R key does.
//
// The game runs in fixed steps of 1/60 s, like Godot's `_physics_process`: each window frame
// adds `window.delta()` to an accumulator and runs one network frame for each whole step in it.
// A headless window's clock is exactly 60 frames a second, so a headless run of N frames runs N
// network frames, and its ending prints:
//
//   frames <N> confirmed <F> checksum <C>
//   rollbacks <R> deepest <D> lost <L>
//   checksums compared up to frame <K>
//   replay matches (<F> frames)
//   wrote pong.replay (<F> frames)
//
// or stops early with "peers differ at frame <F>" when the peers' checksums disagree (and still
// saves the replay, which holds peer 1's frames).
//
// Pong is a reloadable program (`setup` and `frame`, no `main`): under `kestrel run`, an edit
// saved to any of its files is swapped in between two frames, and the game goes on from where
// it was as long as `PongState` stays the same.
use window
use draw
use input
use file
use args
use { Color from draw }
use { Key from input }
use { Pad, WIDTH, HEIGHT, DT, PAD_X, PAD_W, PAD_H, BALL_R, bot from game }
use { Net, new_net from net }
use { Peer, new_peer from peer }
use { Replay, new_replay from replay }

let SEED = 7

// A test sets this to print a line each frame: `trace tick <T> score <A> <B>`.
let TRACE = false

// The most network frames run in one window frame: after a long stall the game skips time
// rather than running many frames at once.
let MAX_STEPS = 4

// Seconds the replay check's result stays on screen.
let SHOW_CHECK = 3.0

// The file a run saves its replay to, next to the program.
let REPLAY_FILE = "pong.replay"

let BACKGROUND = Color(0.06, 0.07, 0.1)
let FOREGROUND = Color(0.92, 0.93, 0.96)
let DIM = Color(0.45, 0.48, 0.55)
let GOOD = Color(0.45, 0.9, 0.5)
let BAD = Color(1, 0.4, 0.35)

// One network frame at frame `s.tick`: packets arrive, each peer rolls back if a guess was
// wrong, runs the present frame with its player's input, looks at newly confirmed frames and
// sends a packet. Player 1 is `keys` when `use_keys`, else the bot. Gives the first frame whose
// checksums differ, or -1.
net_frame(var s: PongState, use_keys: bool, keys: Pad) -> int {
    // The arriving packets are a new list each frame; the arena frees it.
    arena {
        for pk in s.net.deliver(s.tick) {
            if pk.sender == 1 {
                s.p2.receive(pk)
            } else {
                s.p1.receive(pk)
            }
        }
    }
    s.p1.rollback()
    s.p2.rollback()

    // Each bot reads its own peer's present state.
    let pad1 = if use_keys { keys } else { bot(s.p1.game, 1) }
    s.p1.advance(pad1)
    s.p2.advance(bot(s.p2.game, 2))
    s.p1.confirm()
    s.p2.confirm()

    // The replay takes peer 1's newly confirmed frames.
    while s.replay.inputs.len < s.p1.confirmed() {
        let f = s.replay.inputs.len
        s.replay.record(s.p1.inputs_at(f), s.p1.state_at(f + 1))
    }

    s.net.send(s.tick, 1, s.p1.now - 1, s.p1.local, s.p1.sum_frame, s.p1.sum)
    s.net.send(s.tick, 2, s.p2.now - 1, s.p2.local, s.p2.sum_frame, s.p2.sum)
    max(s.p1.compare(), s.p2.compare())
}

// Draws peer `shown`'s view of the game and the status lines.
draw_view(p: Peer, shown: int, rollbacks: int, lost: int, check: int, check_frames: int, check_shown: bool) {
    let g = p.game
    draw.clear(BACKGROUND)
    for k from 0 to 25 {
        draw.rect(vec2(WIDTH / 2 - 2, k * 20 + 4), vec2(4, 12), DIM)
    }
    draw.rect(vec2(PAD_X - PAD_W / 2, g.pad1 - PAD_H / 2), vec2(PAD_W, PAD_H), FOREGROUND)
    draw.rect(vec2(WIDTH - PAD_X - PAD_W / 2, g.pad2 - PAD_H / 2), vec2(PAD_W, PAD_H), FOREGROUND)
    draw.circle(g.ball, BALL_R, FOREGROUND)
    draw.text("{g.score1}", vec2(WIDTH / 2 - 70, 20), 40, FOREGROUND)
    draw.text("{g.score2}", vec2(WIDTH / 2 + 50, 20), 40, FOREGROUND)
    draw.text("peer {shown}'s view   frame {p.now}   confirmed {p.confirmed()}   rollbacks {rollbacks}   lost {lost}",
        vec2(10, HEIGHT - 50), 16, DIM)
    draw.text("W/S: player 1 (a bot when no key is held)   Tab: other peer   R: check the replay", vec2(10, HEIGHT - 26), 16,
        DIM)
    if check_shown {
        if check < 0 {
            draw.text("replay matches ({check_frames} frames)", vec2(10, 70), 20, GOOD)
        } else {
            draw.text("replay differs at frame {check}", vec2(10, 70), 20, BAD)
        }
    }
}

// Prints a replay check's result: `bad` is the first frame whose checksum differs, or -1.
print_check(bad: int, frames: int) {
    if bad < 0 {
        print("replay matches ({frames} frames)")
    } else {
        print("replay differs at frame {bad}")
    }
}

// Saves the replay to REPLAY_FILE. Its bytes are made in an arena of their own, freed once
// written.
save_replay(replay: Replay) {
    arena {
        if file.write(REPLAY_FILE, to_bytes(replay)) {
            print("wrote {REPLAY_FILE} ({replay.inputs.len} frames)")
        } else {
            print(file.error())
        }
    }
}

// Reads the replay saved at `path`, runs it again from its seed and prints the check's result.
check_file(path: string) {
    let bytes = file.read(path) else {
        print(file.error())
        return
    }
    let replay = from_bytes[Replay](bytes) else {
        print("{path} is not a Pong replay; pass a file that a run of Pong wrote, like {REPLAY_FILE}")
        return
    }
    print_check(replay.check(), replay.inputs.len)
}

// The game between two frames. `kestrel run` keeps it across an edit of the program (a hot
// reload) when this struct stays the same.
pub struct PongState {
    p1: Peer
    p2: Peer
    net: Net
    replay: Replay
    // Network frames run so far, the time not yet run, and the first frame whose checksums
    // differ (-1 none).
    tick: int
    acc: float
    differ: int
    // The peer shown, and the replay check's last result (-1 matched), its frames and when it
    // was made.
    shown: int
    check: int
    check_frames: int
    check_at: float
    // The run has ended: its last lines are printed (or it only checked a replay file).
    done: bool
}

// Opens the window and starts both peers. Given a file, Pong checks that replay instead of
// playing, and the state it gives is done.
pub setup() -> PongState {
    let given = args.all()
    let checking = given.len > 0
    if checking {
        check_file(given[0])
    } else {
        window.open(int(WIDTH), int(HEIGHT), "Kestrel rollback pong")
    }
    PongState(p1: new_peer(1, SEED), p2: new_peer(2, SEED), net: new_net(), replay: new_replay(SEED), tick: 0, acc: 0.0,
        differ: -1, shown: 1, check: -1, check_frames: 0, check_at: -SHOW_CHECK, done: checking)
}

// One window frame: the input, the fixed steps and the drawing. When the window closes or the
// peers differ, it prints the run's last lines, saves the replay and gives false.
pub frame(var s: PongState) -> bool {
    if s.done {
        return false
    }
    if not (s.differ < 0 and window.frame()) {
        finish(s)
        s.done = true
        return false
    }

    // Input is read once a window frame, outside the deterministic game.
    let keys = Pad(up: input.held(Key.W), down: input.held(Key.S))
    let use_keys = keys.up or keys.down
    if input.pressed(Key.Tab) {
        s.shown = 3 - s.shown
    }
    if input.pressed(Key.R) {
        s.check = s.replay.check()
        s.check_frames = s.replay.inputs.len
        s.check_at = window.time()
        print_check(s.check, s.check_frames)
    }

    // The fixed steps.
    s.acc += window.delta()
    var steps = 0
    while s.acc >= DT and steps < MAX_STEPS and s.differ < 0 {
        s.acc -= DT
        steps += 1
        s.differ = net_frame(var s, use_keys, keys)
        s.tick += 1
    }
    if steps == MAX_STEPS {
        s.acc = 0.0
    }

    // The text drawn each frame is built in this arena and freed at its end.
    arena {
        let rollbacks = s.p1.rollbacks + s.p2.rollbacks
        let check_shown = window.time() - s.check_at < SHOW_CHECK
        if s.shown == 1 {
            draw_view(s.p1, 1, rollbacks, s.net.lost, s.check, s.check_frames, check_shown)
        } else {
            draw_view(s.p2, 2, rollbacks, s.net.lost, s.check, s.check_frames, check_shown)
        }
        if TRACE {
            print("trace tick {s.tick} score {s.p1.game.score1} {s.p1.game.score2}")
        }
    }
    true
}

// The run's last lines, then the replay saved.
finish(s: PongState) {
    if s.differ >= 0 {
        print("peers differ at frame {s.differ}")
    } else {
        let c = s.p1.confirmed()
        print("frames {s.tick} confirmed {c} checksum {checksum(s.p1.state_at(c))}")
        print("rollbacks {s.p1.rollbacks + s.p2.rollbacks} deepest {max(s.p1.deepest, s.p2.deepest)} lost {s.net.lost}")
        // Both peers have compared every checksum up to this frame and found them equal.
        print("checksums compared up to frame {min(s.p1.compared, s.p2.compared)}")
        print_check(s.replay.check(), s.replay.inputs.len)
    }
    save_replay(s.replay)
}
