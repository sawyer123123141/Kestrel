// The voxel engine, played: an endless world streamed around the player, which walks or flies,
// breaks and places blocks.
//
//   kestrel run --release voxel/main.kes
//
// Controls: WASD to move; Space jumps (walking) or goes up (flying) and Shift goes down; F
// switches between walking and flying; the wheel changes the flying speed. Left click breaks
// the block under the crosshair and right click places stone. The mouse starts free: drag
// with the right button held to look (a right click that moves less than 4 pixels places a
// block instead). Tab captures the mouse, as in a first-person game: moving it looks, and
// Tab frees it again. F5 saves the world to `world.save` next to this file and F9 loads it
// (`save.kes`); nothing is loaded at the start.
//
// Each frame, in order (as a Godot `_process` would): input to an `Intent`, saving or loading,
// spawning until the first column is ready, the player, the edit, streaming, meshing and uploading, drawing, the
// HUD. A stats line is printed once a second:
//
//   voxel fps <f> work_ms <f> columns <n> chunks <n> faces <n> queue <n> mode <walk|fly>
//
// `work_ms` is the frame's own work, timed from the start of the frame to just before
// `window.frame()`, averaged over the second (the rest of the frame is waiting for the display).
// Everything the game keeps lives in `VoxelState`: there are no globals. The program is
// reloadable (`setup` and `frame`, no `main`): under `kestrel run`, an edit saved to any of its
// files is swapped in between two frames, and the world, the player and the meshes stay as they
// were as long as `VoxelState` stays the same.
use window
use draw
use input
use file
use { Color from draw }
use { Key from input }
use { World, new_world from world }
use { Stream, new_stream, stream_step, VIEW, CAPACITY, GEN_BATCH, MESH_BATCH from stream }
use { Intent, Player, new_player, step_player, spawn, eye, look, view from player }
use { apply_edit, REACH from edit }
use { Render, new_render, mesh_step, draw_world, meshed_chunks from render }
use { draw_hud, two from hud }
use { cast from ray }
use { save_world, load_world, load_failure, SAVE_FILE from save }

let SEED = 1337
let SCREEN_WIDTH = 1280
let SCREEN_HEIGHT = 720
let SKY = Color(0.55, 0.75, 0.95)

// Where the player starts: above the middle of column (0, 0), flying until it is ready.
let START = vec3(16.5, 140, 16.5)

// A right click that moves the mouse less than this many pixels (uncaptured) places a block;
// more is a drag that looks.
let CLICK = 4.0

// Seconds between the printed stats lines.
let REPORT = 1.0

// A test sets this to print a line each frame: `trace pos <x> <y> <z> spawned <bool> columns <n>`.
let TRACE = false

// Everything the game keeps between two frames. `kestrel run` keeps it across an edit of the
// program (a hot reload) when this struct stays the same; the meshes in `r` stay on the GPU.
pub struct VoxelState {
    w: World
    s: Stream
    r: Render
    p: Player
    spawned: bool
    // The mouse: captured or not, where it was last frame, and the right button's press so far
    // (where it went down and how far the mouse has gone from there).
    captured: bool
    last_mouse: vec2
    press_at: vec2
    drag: float
    // Sums over the current second, and the values the last stats line printed.
    frames: int
    work_sum: i64
    interval_start: float
    fps: float
    work_ms: float
}

// Opens the window and makes an empty world around the player's start.
pub setup() -> VoxelState {
    window.open(SCREEN_WIDTH, SCREEN_HEIGHT, "Kestrel voxels")
    VoxelState(w: new_world(SEED, CAPACITY), s: new_stream(VIEW, GEN_BATCH), r: new_render(CAPACITY), p: new_player(START),
        spawned: false, captured: false, last_mouse: input.mouse(), press_at: vec2(0, 0), drag: 0.0, frames: 0,
        work_sum: i64(0), interval_start: window.time(), fps: 0.0, work_ms: 0.0)
}

// One frame; false when the window has closed.
pub frame(var v: VoxelState) -> bool {
    if not window.frame() {
        return false
    }
    let t0 = window.ticks_usec()

    // Input to intent.
    let toggled = input.pressed(Key.Tab)
    if toggled {
        v.captured = not v.captured
        input.capture(v.captured)
        v.drag = CLICK
    }
    let mouse = input.mouse()
    var turn = vec2(0, 0)
    var place = false
    if v.captured {
        // The frame that captures the mouse doesn't turn: its delta can include the cursor's
        // jump to the middle of the window.
        if not toggled {
            turn = input.mouse_delta()
        }
        place = input.pressed(Key.MouseRight)
    } else {
        if input.pressed(Key.MouseRight) {
            v.press_at = mouse
            v.drag = 0.0
        }
        if input.held(Key.MouseRight) {
            turn = mouse - v.last_mouse
        }
        // The release frame's movement counts toward the click rule too.
        if input.held(Key.MouseRight) or input.released(Key.MouseRight) {
            v.drag = max(v.drag, (mouse - v.press_at).length())
        }
        if input.released(Key.MouseRight) and v.drag < CLICK {
            place = true
        }
    }
    v.last_mouse = mouse
    let i = Intent(move: vec3(input.axis(Key.A, Key.D), input.axis(Key.Shift, Key.Space), input.axis(Key.S, Key.W)),
        turn: turn, jump: input.held(Key.Space), wheel: input.wheel(), break_block: input.pressed(Key.MouseLeft),
        place_block: place, toggle_fly: input.pressed(Key.F))

    // Saving and loading. A loaded player is where it was saved, so it doesn't spawn again; until
    // its columns are Ready again it stands still (a column that isn't Ready is stone).
    if input.pressed(Key.F5) {
        if save_world(v.w, v.p) {
            print("saved {SAVE_FILE}")
        } else {
            print("could not save: {file.error()}")
        }
    }
    if input.pressed(Key.F9) {
        if load_world(var v.w, var v.p) {
            v.spawned = true
            print("loaded {SAVE_FILE}")
        } else {
            print(load_failure())
        }
    }

    // The world.
    if not v.spawned {
        v.spawned = spawn(var v.p, v.w)
    }
    step_player(var v.p, v.w, i, window.delta())
    let dirty = apply_edit(var v.w, v.p, i)
    stream_step(var v.s, var v.w, v.p.pos)
    mesh_step(var v.r, var v.w, dirty, MESH_BATCH, v.p.pos, VIEW)

    // Drawing.
    draw.clear(SKY)
    let size = window.size()
    draw_world(v.r, v.w, view(v.p), size.x / size.y)
    draw_hud(cast(v.w, eye(v.p), look(v.p), REACH), v.p, v.fps, v.work_ms, v.w.columns.in_use(), meshed_chunks(v.r),
        v.r.total_faces, v.w.queue.len(), v.captured)

    // Stats, once a second.
    v.frames += 1
    v.work_sum += window.ticks_usec() - t0
    let elapsed = window.time() - v.interval_start
    if elapsed >= REPORT {
        v.fps = float(v.frames) / elapsed
        v.work_ms = float(v.work_sum) / float(v.frames) / 1000.0
        let mode = if v.p.fly { "fly" } else { "walk" }
        print("voxel fps {two(v.fps)} work_ms {two(v.work_ms)} columns {v.w.columns.in_use()} chunks {meshed_chunks(v.r)} faces {v.r.total_faces} queue {v.w.queue.len()} mode {mode}")
        v.frames = 0
        v.work_sum = i64(0)
        v.interval_start += elapsed
    }
    if TRACE {
        arena {
            print("trace pos {v.p.pos.x} {v.p.pos.y} {v.p.pos.z} spawned {v.spawned} columns {v.w.columns.in_use()}")
        }
    }
    true
}
