struct World {
    seed: int
    chunks: list[int]
}

struct Outer {
    world: World
}

enum Bag {
    Empty
    Full { items: [int] }
}

struct Pool {
    mem: Arena
}

struct Pair[A, B] {
    a: A
    b: B
}

count[T: equatable](xs: list[T], x: T) -> int { 0 }

check(w: World, o: Outer, g: Bag, p: Pool, ws: list[World], ps: list[Pair[int, list[int]]], q: Pair[int, list[int]]) {
    let a = w == w
    let b = o != o
    let c = g == g
    let d = p == p
    let e = count(ws, w)
    let f = count(ps, q)
    let h = ws.has(w)
    print(a, b, c, d, e, f, h)
}

