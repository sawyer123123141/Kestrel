// The built-in `Result[T, E]` (decisions 7 and 8): its name is reserved, a value goes in as `Ok`
// only when it converts to `T` and isn't an `E`, and only `Result` may hold an optional.
struct World {
    a: Arena
}

enum Result {
    A
}

struct Box[Result] {
    v: int
}

enum Maybe[T] {
    Nothing
    Just { value: T }
}

keep(w: Result[World, string]) {}

call(f: Result[(int) -> int, string]) {}

hold(m: Maybe[int?]) {}

main() {
    let a: Result[int, string] = "x"
    let b: Result[string, string] = "x"
    let c: Result[float, int] = 3
    let d: Result[int, string] = true
    let fine: Result[int?, string] = 3
}

// `try` and `let ... else why` (decisions 9 and 10).
pure half(n: int) -> Result[int, string] {
    if n % 2 != 0 {
        return Result.Err(error: "odd")
    }
    n / 2
}

pure code(n: int) -> Result[int, int] {
    Result.Err(error: n)
}

pure maybe(n: int) -> int? {
    none
}

run() {
    let x = try half(2)
}

pure load(n: int) -> Result[int, string] {
    let x = try code(n)
    x
}

pure both(n: int) -> Result[int, string] {
    let a = try maybe(n)
    a
}

pure other(n: int) -> int? {
    let a = try half(n)
    a
}

pure plain(n: int) -> Result[int, string] {
    try n
}

pure halves(xs: list[int]) -> Result[int, string] {
    par for x in xs {
        let h = try half(x)
    }
    xs[0]
}

pure closures(n: int) -> int {
    let f = (k: int) { let v = try half(k) }
    n
}

let K = try half(4)

struct Cfg {
    n: int = try half(4)
}

pure count(s: string) -> Result[int, string] {
    if s == "" {
        return Result.Err(error: "empty")
    }
    s.len
}

tally(names: list[string]) -> Result[int, string] {
    var total = 0
    arena {
        let n = try count("{names.len}")
        total += n
    }
    total
}

pure name_opt(o: int?) -> int {
    let v = o else why { return 0 }
    v
}

pure shadow(id: int) -> int {
    let why = 3
    let v = half(id) else why { return 0 }
    v
}

pure stays(id: int) -> int {
    let v = half(id) else why { let w = why }
    v
}

pure typed(id: int) -> int {
    let v: string = half(id) else { return 0 }
    0
}
