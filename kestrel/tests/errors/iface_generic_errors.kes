interface Handler[E] {
    pure handle(self, e: E) -> int
}
interface Holder[T] {
    get(self) -> T
}
interface Named {
    pure name(self) -> string
}
struct Click {
    x: int
}
struct Key {
    code: int
}
struct Button: Handler[Click], Handler[Key] {
    pure handle(self, e: Click) -> int { e.x }
}
struct Bare: Handler {
    pure handle(self, e: int) -> int { e }
}
struct Box[T]: Holder[T] {
    v: T
    get(self) -> T { self.v }
}
struct Wrong: Handler[int] {
    pure handle(self, e: string) -> int { 0 }
}
struct Extra: Named[int] {
    pure name(self) -> string { "x" }
}
struct Twice: Handler[int], Handler[int] {
    pure handle(self, e: int) -> int { e }
}
interface Grow[T] {
    more(self) -> Grow[list[T]]
}
use_bare(h: Handler) -> int { 0 }
pick[G: Handler[int] + Handler[string]](g: G) -> int { 0 }
count(hs: list[Handler[int, int]]) -> int { hs.len }
main() {}
