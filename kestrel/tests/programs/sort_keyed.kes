// expect: [-2, 0, -0, 0, NaN, NaN] 5711930068764211585
// expect: [0]
// `sort_by` with number and bool keys, and `sort` on numbers and bools: the exact order of items
// with equal keys (they keep their first order), NaN keys after every number and equal to each
// other whatever their sign, `-0.0` equal to `0.0`, infinities, `i64` keys at the type's least and
// greatest values, short lists and long ones, lists and arrays. `checksum` shows every bit of the
// sorted floats, so a NaN's sign and `-0.0` against `0.0` count. The key runs once per item, in
// item order, and not at all for a list of fewer than two items.
struct It {
    k: i64
    f: f64
    g: float
    n: int
    b: u8
    id: int
}

ids(xs: list[It]) -> list[int] {
    xs.map((e) { e.id })
}

hash(xs: list[It]) -> int {
    var s = 0
    for e in xs {
        s = (s * 31 + e.id) % 1000003
    }
    s
}

pick_k(r: int) -> i64 {
    let least = i64(-9223372036854775807) - i64(1)
    let most = i64(9223372036854775807)
    let pool = [least, most, i64(-1), i64(0), i64(1), least + i64(1), most - i64(1), i64(42), i64(-42), i64(4294967296)]
    pool[r % 10]
}

pick_f(r: int) -> f64 {
    var z = f64(0.0)
    let nan = z / z
    // The least subnormal and a power of two near the greatest float, made exactly.
    var tiny = f64(1.0)
    var big = f64(1.0)
    for i from 0 to 1074 {
        tiny = tiny / f64(2.0)
    }
    for i from 0 to 1023 {
        big = big * f64(2.0)
    }
    let pool = [nan, -nan, f64(-0.0), f64(0.0), f64(1.0) / z, f64(-1.0) / z, f64(1.5), f64(-1.5), tiny, -tiny, big, f64(2.5)]
    pool[r % 12]
}

pick_g(r: int) -> float {
    var z = 0.0
    let nan = z / z
    let pool = [nan, -nan, -0.0, 0.0, 1.0 / z, -1.0 / z, 0.25, -0.25, 3.0]
    pool[r % 9]
}

make(n: int, seed: int) -> list[It] {
    var out = list[It]()
    var r = seed
    for i from 0 to n {
        r = (r * 75 + 74) % 65537
        let a = r
        r = (r * 75 + 74) % 65537
        out.add(It(k: pick_k(a), f: pick_f(r), g: pick_g(a + r), n: (r % 7) - 3, b: u8(a % 5), id: i))
    }
    out
}

show(xs: list[It]) {
    if xs.len <= 20 {
        print(ids(xs))
    } else {
        print(xs.len, hash(xs))
    }
}

main() {
    for n in [0, 1, 2, 3, 12, 63, 64, 65, 200, 3000] {
        let base = make(n, 7 + n)
        var xs = base
        xs.sort_by((e) { e.k })
        show(xs)
        xs = base
        xs.sort_by((e) { e.f })
        show(xs)
        xs = base
        xs.sort_by((e) { e.g })
        show(xs)
        xs = base
        xs.sort_by((e) { e.n })
        show(xs)
        xs = base
        xs.sort_by((e) { e.b })
        show(xs)
        xs = base
        xs.sort_by((e) { e.n < 0 })
        show(xs)
        xs = base
        xs.sort_by((e) { 0 - e.id })
        show(xs)
        xs = base
        xs.sort_by((e) { e.f * f64(-1.0) })
        show(xs)
        // The same keys through a named function and through a function value.
        xs = base
        xs.sort_by(key_of)
        show(xs)
        let by = (e: It) -> f64 { e.f }
        xs = base
        xs.sort_by(by)
        show(xs)
        // `sort` on the keys themselves.
        var ks: list[i64] = base.map((e) { e.k })
        ks.sort()
        var fs: list[f64] = base.map((e) { e.f })
        fs.sort()
        var gs: list[float] = base.map((e) { e.g })
        gs.sort()
        var ns: list[int] = base.map((e) { e.n })
        ns.sort()
        var bs: list[u8] = base.map((e) { e.b })
        bs.sort()
        var ts: list[bool] = base.map((e) { e.n < 0 })
        ts.sort()
        if n <= 12 {
            // (The floats of `fs` are shown by their checksum: one is a long subnormal.)
            print(ks, gs, ns, bs, ts)
        }
        print(checksum(ks), checksum(fs), checksum(gs), checksum(ns), checksum(bs), checksum(ts))
    }

    // An array sorts like a list.
    var arr = array[f64](6)
    var z = f64(0.0)
    arr[0] = f64(0.0)
    arr[1] = z / z
    arr[2] = f64(-0.0)
    arr[3] = -(z / z)
    arr[4] = f64(-2.0)
    arr[5] = f64(0.0)
    var arr2 = arr
    arr.sort()
    print(arr, checksum(arr))
    arr2.sort_by((x) { x })
    print(arr2, checksum(arr2))

    // A key that would fail is never run for a list of fewer than two items.
    let lookup = [10, 20, 30]
    var one = list[It]()
    one.add(It(k: i64(0), f: f64(0.0), g: 0.0, n: 9, b: u8(0), id: 0))
    one.sort_by((e) { lookup[e.n] })
    print(ids(one))
}

pure key_of(e: It) -> i64 {
    e.k
}
