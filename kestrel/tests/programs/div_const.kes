// expect: 16 true 2 0
// Division and remainder by literals truncate toward zero for every sign, like Rust's `/` and `%`.
let BIG: list[i64] = [-5000000000, -1000003, 1000002, 5000000000]
let XS: list[i64] = [-1000, -15, -14, -8, -7, -6, -1, 0, 1, 6, 7, 8, 14, 15, 1000, 123456789]

main() {
    for x in XS {
        print(x, x / 7, x % 7, x / -7, x % -7, x / 10, x % 10, x / -1000003, x % -1000003)
    }
    for n in BIG {
        print(n, n / -1000003, n % -1000003)
    }
    for x in [-9, -8, -3, -2, -1, 0, 1, 2, 3, 8, 9] {
        print(x, x % 2 == 0, x % 2 != 0, x % 8 == 0)
    }
    for x in [-24, -17, -16, -8, -1, 0, 8, 9, 16] {
        let small: int = x
        print(small, small % 8 == 0, small / 8, small % 8)
    }
}
