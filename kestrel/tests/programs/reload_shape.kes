// A reloadable program: no `main`; `setup` makes the state and `frame` runs one frame until it
// returns false. Everything but the reloading host runs it through the `main` the compiler makes
// for it, which reload_shape_main.kes writes out: the same output under `run` and `build`, the
// same proofs, the same report rows.
let STEPS = [10, 20, 30]

struct Counter {
    n: int
    total: int
    seen: list[int]
    label: string
}

@prove(no_alloc)
pure step(n: int) -> int {
    STEPS[n % 3]
}

pub setup() -> Counter {
    print("setup")
    Counter(n: 0, total: 0, seen: [], label: "frame")
}

pub frame(var s: Counter) -> bool {
    s.total += step(s.n)
    s.n += 1
    s.seen.add(s.total)
    print(s.label, s.n, s.total, s.seen.len)
    s.n < 3
}

// expect: setup
// expect: frame 1 10 1
// expect: frame 2 30 2
// expect: frame 3 60 3
