enum Outcome[T, E] {
    Ok { value: T }
    Err { error: E }

    pure is_ok(self) -> bool {
        match self {
            Ok { true }
            Err { false }
        }
    }
}

enum Maybe[T] {
    Nothing
    Just { value: T }
}

struct Level {
    name: string
    size: int
}

load(name: string) -> Outcome[Level, string] {
    if name == "cave" {
        return Outcome.Ok(value: Level(name: name, size: 3))
    }
    Outcome.Err(error: "no level {name}")
}

pure unwrap_or[T, E](r: Outcome[T, E], d: T) -> T {
    match r {
        Ok o { o.value }
        Err { d }
    }
}

main() {
    match load("cave") {
        Ok r { print(r.value.size) }
        Err e { print(e.error) }
    }
    match load("sky") {
        Ok r { print(r.value.size) }
        Err e { print(e.error) }
    }
    let three = Outcome[int, string].Ok(value: 3)
    print(three, three.is_ok())
    let bad: Outcome[int, string] = Outcome.Err(error: "nope")
    print(unwrap_or(three, 0), unwrap_or(bad, -1), bad.is_ok())
    let m: Maybe[int] = Maybe.Nothing
    let n = Maybe[int].Nothing
    let j = Maybe.Just(value: 5)
    print(m, n, j)
}
// expect: 3
// expect: no level sky
// expect: Outcome[int, string].Ok(value: 3) true
// expect: 3 -1 false
// expect: Maybe[int].Nothing Maybe[int].Nothing Maybe[int].Just(value: 5)
